# Environment variables for UniVerse backend

# Server
NODE_ENV=development
PORT=3000
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Aynı ağdan başka PC (ör. http://192.168.1.42:5173) — virgülle birden fazla origin
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173

# `npm run sync:frontend-env`: frontend/.env içine VITE_UPLOADS_BASE_URL yazmak için (çoğu kurulumda gerekmez)
# FRONTEND_UPLOADS_BASE_URL=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=universe
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=20

# Logging
LOG_LEVEL=info

# Monitoring (optional, default: disabled)
# MONITORING_ENABLED=false
# MONITORING_WEBHOOK_URL=https://your-monitoring-endpoint.example/webhook

# Secrets provider: env | file | azure-keyvault
# SECRET_PROVIDER=env
# SECRETS_FILE_PATH=./backend.secrets.json
# Azure Key Vault (SECRET_PROVIDER=azure-keyvault)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Optional JSON map env var name -> Key Vault secret name:
# AZURE_KEY_VAULT_MAPPING={"SESSION_SECRET":"session-secret","DB_PASSWORD":"db-password"}

# Authorization audit (ABAC/RBAC allow logs to winston)
# AUTHORIZATION_AUDIT_ENABLED=false
# W3C trace context in request logs
# TRACEPARENT_LOGGING_ENABLED=true

# Upload security scanning
# MALWARE_SCAN_MODE=disabled
# VIRUSTOTAL_MAX_FILE_BYTES=33554432
# VIRUSTOTAL_POLL_MAX_ATTEMPTS=35
# VIRUSTOTAL_POLL_DELAY_MS=1000
# MALWARE_SCAN_FAIL_ON_ERROR=false
# VIRUSTOTAL_API_KEY=

# Environment profile examples
# development -> BACKEND_PUBLIC_URL=http://localhost:3000 / FRONTEND_URL=http://localhost:5173
# staging -> BACKEND_PUBLIC_URL=https://staging-api.example.com / FRONTEND_URL=https://staging.example.com
# production -> BACKEND_PUBLIC_URL=https://api.example.com / FRONTEND_URL=https://example.com

# Render: RENDER=true ile trust proxy açılır; kendi reverse proxy için TRUST_PROXY=1.

# Platform administrator (reserved email; self-service registration blocked; strong password on change; single-session login)
# PLATFORM_ADMIN_EMAIL=admin@yasar.edu.tr
# One-time new admin: BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=... then: npm run db:bootstrap-platform-admin --prefix backend

# Supabase Storage (ZORUNLU — tüm fotoğraf / video / CV yüklemeleri yalnızca bucket’a gider)
# Dashboard → Project Settings → API: Project URL + service_role secret
# Dashboard → Storage → New bucket → Public bucket veya anon read policy
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket adı (Dashboard ile aynı; varsayılan: uploads)
# SUPABASE_STORAGE_BUCKET=uploads

# Arama: PostgreSQL tam metin (Supabase/Postgres; migrations/016_search_postgres_and_view.sql uygulayın: pg_trgm, v_user_search, indeksler)

# Yemek listesi PDF (varsayılan: yasar.edu.tr). Sunucu IP’si Cloudflare’de 403 alırsa aynı dosyayı S3/public URL’e koyup burada verin.
# YASAR_MENU_PDF_URL=https://www.yasar.edu.tr/yemek-liste.pdf


