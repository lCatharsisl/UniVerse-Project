# Copy to .env and fill in values. SESSION_SECRET is required (min 32 characters).

NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long

FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000

# Supabase (Project Settings → Database): prefer URI with ssl — or use DB_* below.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@....pooler.supabase.com:6543/postgres

# Alternative: individual fields (SSL is applied automatically when DB_HOST contains "supabase")
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=

DB_MAX_CONNECTIONS=20
LOG_LEVEL=info

# Microsoft login (optional)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
