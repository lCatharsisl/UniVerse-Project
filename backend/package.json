{
  "name": "universe-backend",
  "version": "1.0.0",
  "description": "UniVerse REST API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "messages:migrate": "node scripts/apply-messaging-migration.js",
    "messages:mute-migrate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/apply-conversation-notifications-mute-migration.js",
    "notifications:migrate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/apply-notifications-migration.js",
    "menu:verify": "tsx scripts/verify-menu-pdf.ts",
    "menu:refresh": "tsx scripts/refresh-cache-from-pdf.ts",
    "calendar:parse": "tsx scripts/parse-academic-calendar.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^5.1.2",
    "@supabase/supabase-js": "^2.104.1",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.4",
    "pdf2json": "^4.0.2",
    "pg": "^8.11.3",
    "puppeteer-core": "^24.42.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "glob": "7.2.3",
    "minimatch": "3.1.4",
    "brace-expansion": "1.1.13"
  }
}
