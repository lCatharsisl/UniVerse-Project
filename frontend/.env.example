# Local dev: leave unset — Vite proxies /api and /uploads to the backend.
# Vercel production: set to your Render (or other) backend origin, no trailing slash.
# Example: VITE_API_ORIGIN=https://universe-api-xxxx.onrender.com
#
# Optional: override uploads base only (defaults to VITE_API_ORIGIN when unset).
# VITE_UPLOADS_BASE_URL=https://universe-api-xxxx.onrender.com

VITE_API_ORIGIN=
